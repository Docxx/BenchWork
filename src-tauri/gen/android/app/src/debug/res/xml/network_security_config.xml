<?xml version="1.0" encoding="utf-8"?>
<!--
  As in main, but debug builds may load the development server over plain
  HTTP. ML Kit's usage statistics are blocked here too.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">firebaselogging.googleapis.com</domain>
        <domain includeSubdomains="true">firebaselogging-pa.googleapis.com</domain>
        <pin-set>
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
